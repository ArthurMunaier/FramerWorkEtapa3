rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Perfis: todos logados leem; cada um grava só o próprio.
    match /usuarios/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
    }

    // Publicações: todos logados leem; só o autor cria/exclui as suas.
    match /publicacoes/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.autorId == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.autorId == request.auth.uid;
    }

    // Comentários
    match /comentarios/{id} {
      allow read: if request.auth != null;

      // Só pode criar comentário em seu próprio nome (UID verdadeiro).
      allow create: if request.auth != null
                    && request.resource.data.autorId == request.auth.uid
                    && request.resource.data.texto is string
                    && request.resource.data.texto.size() > 0
                    && request.resource.data.texto.size() <= 280
                    && request.resource.data.publicacaoId is string
                    && request.resource.data.autorNome is string;

      // Comentários não são editáveis.
      allow update: if false;

      // Só o autor exclui o próprio comentário.
      allow delete: if request.auth != null
                    && resource.data.autorId == request.auth.uid;
    }
  }
}
